# Server Port (defaults to 8080 matching Vite proxy)
PORT=8080
NODE_ENV=development

# PostgreSQL + PGVector Connection String
# Example for local Docker / PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesense_db
# Or Supabase / Neon / Cloud PGVector:
# DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres

# AI Provider Selection ('nvidia' or 'gemini')
AI_PROVIDER=nvidia

# NVIDIA NIM Configuration (Minimax / OpenAI-compatible endpoint)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Embedding Provider Selection ('gemini' or 'voyage')
EMBEDDING_PROVIDER=gemini

# Google Gemini API Configuration (Embeddings & Chat RAG fallback)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Chat RAG Retrieval Limits
CHAT_RETRIEVAL_LIMIT=6
CHAT_MAX_CONTEXT_CHARS=12000

# Voyage AI Embeddings (Optional / Legacy Provider)
# Sign up at https://dash.voyageai.com/ to get your key
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-code-3
VOYAGE_DIMENSION=1536

# GitHub Personal Access Token (Optional, increases API rate limits from 60/hr to 5,000/hr)
# Create at https://github.com/settings/tokens (read-only 'public_repo' scope is enough)
GITHUB_TOKEN=
