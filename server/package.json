{
  "name": "codesense-server-ts",
  "version": "1.0.0",
  "description": "TypeScript backend for GitHub Repo & PR Analysis with Voyage AI embeddings, PGVector vector store, and Gemini PR reviews",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx src/test/auditVerification.ts",
    "test:rag": "tsx src/test/geminiRagVerification.ts",
    "test:integration": "tsx src/test/integrationPipelineTest.ts",
    "test:hardening": "tsx src/test/productionHardeningVerification.ts",
    "test:oauth": "tsx src/test/githubOAuthVerification.ts",
    "test:impact": "tsx src/test/deepPrImpactVerification.ts",
    "test:all": "tsx src/test/auditVerification.ts && tsx src/test/geminiRagVerification.ts && tsx src/test/integrationPipelineTest.ts && tsx src/test/productionHardeningVerification.ts && tsx src/test/githubOAuthVerification.ts && tsx src/test/deepPrImpactVerification.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
