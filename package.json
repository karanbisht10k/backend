{
  "name": "codesense-workspace",
  "version": "1.0.0",
  "description": "CodeSense - AI Codebase Comprehension & PR Review Copilot powered by TypeScript, Voyage AI, PGVector, and Google Gemini",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npx concurrently \"npm run dev --prefix server\" \"npm run dev --prefix frontend\"",
    "build:server": "npm run build --prefix server",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:server && npm run build:frontend",
    "test": "npm test --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "test:all": "npm run test:all --prefix server",
    "start": "npm run start --prefix server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "ast",
    "typescript",
    "pgvector",
    "voyage-ai",
    "gemini"
  ],
  "author": "",
  "license": "MIT"
}
